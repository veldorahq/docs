{
    "name": "veldora/docs",
    "description": "Official documentation site for the Veldora PHP Framework",
    "version": "1.0.0",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "veldora/framework": "*@dev",
        "erusev/parsedown": "^1.7"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../veldora-core",
            "options": { "symlink": true }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    }
}
